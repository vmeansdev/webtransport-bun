{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://webtransport-bun.local/docs/release-evidence.schema.json",
	"title": "WebTransport release evidence artifact",
	"oneOf": [
		{
			"$ref": "#/$defs/commandRecord"
		},
		{
			"$ref": "#/$defs/summaryRecord"
		}
	],
	"$defs": {
		"sha256": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"platform": {
			"type": "object",
			"additionalProperties": false,
			"required": ["os", "arch", "runtime"],
			"properties": {
				"os": {
					"type": "string",
					"minLength": 1
				},
				"arch": {
					"type": "string",
					"minLength": 1
				},
				"runtime": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"toolchain": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "version"],
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1
				},
				"version": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"commandRecord": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"schemaVersion",
				"kind",
				"name",
				"commit",
				"platform",
				"toolchain",
				"command",
				"exitCode",
				"startedAt",
				"finishedAt",
				"artifactSha256"
			],
			"properties": {
				"schemaVersion": {
					"const": 1
				},
				"kind": {
					"const": "command"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"commit": {
					"type": "string",
					"pattern": "^[0-9a-f]{40}$"
				},
				"platform": {
					"$ref": "#/$defs/platform"
				},
				"toolchain": {
					"$ref": "#/$defs/toolchain"
				},
				"command": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"exitCode": {
					"type": "integer"
				},
				"startedAt": {
					"type": "string",
					"format": "date-time"
				},
				"finishedAt": {
					"type": "string",
					"format": "date-time"
				},
				"artifactSha256": {
					"$ref": "#/$defs/sha256"
				}
			}
		},
		"summaryItem": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "path", "artifactSha256"],
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1
				},
				"path": {
					"type": "string",
					"pattern": "^(commands/)?[A-Za-z0-9._-]+\\.json$"
				},
				"artifactSha256": {
					"$ref": "#/$defs/sha256"
				}
			}
		},
		"summaryRecord": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"schemaVersion",
				"kind",
				"commit",
				"generatedAt",
				"recordCount",
				"records"
			],
			"properties": {
				"schemaVersion": {
					"const": 1
				},
				"kind": {
					"const": "summary"
				},
				"commit": {
					"type": "string",
					"pattern": "^[0-9a-f]{40}$"
				},
				"generatedAt": {
					"type": "string",
					"format": "date-time"
				},
				"recordCount": {
					"type": "integer",
					"minimum": 0
				},
				"records": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/summaryItem"
					}
				}
			}
		}
	}
}
