{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://webtransport-bun.local/docs/release-evidence-manifest.schema.json",
	"title": "WebTransport release evidence manifest",
	"description": "Checksum manifest for release evidence stored as GitHub Release assets of the candidate pre-release. Enforced by scripts/release-evidence-lib.ts (validateManifest); keep both in step. Rules the schema cannot express: every entry commit equals candidate.commit, candidate.tag is v<packageVersion> or a pre-release of it, and promotion.tag/tagCommit equal the candidate.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"repository",
		"packageVersion",
		"candidate",
		"claimRegistrySha256",
		"promotion",
		"entries"
	],
	"properties": {
		"schemaVersion": {
			"const": 1
		},
		"repository": {
			"$ref": "#/$defs/repository"
		},
		"packageVersion": {
			"description": "Base version (X.Y.Z) committed in packages/webtransport/package.json at the candidate; published versions are stamped from the tag.",
			"oneOf": [
				{
					"type": "null"
				},
				{
					"type": "string",
					"pattern": "^\\d+\\.\\d+\\.\\d+$"
				}
			]
		},
		"candidate": {
			"type": "object",
			"additionalProperties": false,
			"required": ["commit", "tag"],
			"properties": {
				"commit": {
					"oneOf": [
						{
							"type": "null"
						},
						{
							"$ref": "#/$defs/commit"
						}
					]
				},
				"tag": {
					"description": "Pre-release tag whose release carries the evidence assets; must point to commit.",
					"oneOf": [
						{
							"type": "null"
						},
						{
							"type": "string",
							"pattern": "^v\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
						}
					]
				}
			}
		},
		"claimRegistrySha256": {
			"description": "sha256 of docs/release-claims.json at the candidate commit; the GA gate set the evidence is judged against.",
			"oneOf": [
				{
					"type": "null"
				},
				{
					"$ref": "#/$defs/sha256"
				}
			]
		},
		"promotion": {
			"description": "Written by scripts/promote-release-status.ts: the release state that was verified. Later changes to the tag or the evidence assets fail verification.",
			"oneOf": [
				{
					"type": "null"
				},
				{
					"$ref": "#/$defs/promotion"
				}
			]
		},
		"entries": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/entry"
			}
		}
	},
	"$defs": {
		"repository": {
			"type": "string",
			"pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
		},
		"commit": {
			"type": "string",
			"pattern": "^[0-9a-f]{40}$"
		},
		"sha256": {
			"type": "string",
			"pattern": "^[0-9a-f]{64}$"
		},
		"entry": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"claimIds",
				"asset",
				"size",
				"sha256",
				"commit",
				"status",
				"producer",
				"createdAt",
				"files"
			],
			"properties": {
				"id": {
					"description": "Referenced from release-status.json claims[].evidenceIds.",
					"type": "string",
					"pattern": "^[a-z0-9][a-z0-9.-]{2,119}$"
				},
				"claimIds": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"pattern": "^[a-z0-9][a-z0-9-]*$"
					}
				},
				"asset": {
					"description": "Release asset name: evidence-<id>.json or evidence-<id>.tar.gz.",
					"type": "string",
					"pattern": "^evidence-[a-z0-9][a-z0-9.-]{2,119}\\.(?:json|tar\\.gz)$"
				},
				"size": {
					"type": "integer",
					"minimum": 1
				},
				"sha256": {
					"$ref": "#/$defs/sha256"
				},
				"commit": {
					"description": "Commit the evidence was produced at; equals candidate.commit.",
					"$ref": "#/$defs/commit"
				},
				"status": {
					"enum": ["passed", "failed"]
				},
				"producer": {
					"oneOf": [
						{
							"$ref": "#/$defs/githubActionsProducer"
						},
						{
							"$ref": "#/$defs/localProducer"
						}
					]
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				},
				"files": {
					"description": "Scrubbed files inside the asset (the asset itself for a .json asset).",
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["name", "size", "sha256"],
						"properties": {
							"name": {
								"type": "string",
								"minLength": 1,
								"maxLength": 255
							},
							"size": {
								"type": "integer",
								"minimum": 0
							},
							"sha256": {
								"$ref": "#/$defs/sha256"
							}
						}
					}
				}
			}
		},
		"githubActionsProducer": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"kind",
				"repository",
				"workflow",
				"workflowPath",
				"runId",
				"runAttempt",
				"url",
				"headSha",
				"artifact"
			],
			"properties": {
				"kind": {
					"const": "github-actions"
				},
				"repository": {
					"$ref": "#/$defs/repository"
				},
				"workflowPath": {
					"description": "The run's workflow file as the Actions API reports it; must be a producer registered for the claim in docs/release-claims.json.",
					"type": "string",
					"pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$"
				},
				"workflow": {
					"type": "string",
					"minLength": 1
				},
				"runId": {
					"type": "integer",
					"minimum": 1
				},
				"runAttempt": {
					"type": "integer",
					"minimum": 1
				},
				"url": {
					"type": "string",
					"pattern": "^https://github\\.com/[^/]+/[^/]+/actions/runs/\\d+(?:/attempts/\\d+)?$"
				},
				"headSha": {
					"description": "The run's head commit; equals the entry commit.",
					"$ref": "#/$defs/commit"
				},
				"artifact": {
					"description": "The run artifact the evidence bytes were downloaded from; verify re-checks it against the run's artifact listing.",
					"type": "object",
					"additionalProperties": false,
					"required": ["id", "name", "digest"],
					"properties": {
						"id": {
							"type": "integer",
							"minimum": 1
						},
						"name": {
							"type": "string",
							"pattern": "^[A-Za-z0-9._-]+$"
						},
						"digest": {
							"type": "string",
							"pattern": "^sha256:[0-9a-f]{64}$"
						}
					}
				}
			}
		},
		"localProducer": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "description"],
			"properties": {
				"kind": {
					"const": "local"
				},
				"description": {
					"description": "Who/what produced it, without host paths, logins or hostnames.",
					"type": "string",
					"minLength": 1,
					"maxLength": 300
				}
			}
		},
		"promotion": {
			"type": "object",
			"additionalProperties": false,
			"required": ["tag", "tagCommit", "verifiedAt", "assets"],
			"properties": {
				"tag": {
					"type": "string",
					"pattern": "^v\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
				},
				"tagCommit": {
					"$ref": "#/$defs/commit"
				},
				"verifiedAt": {
					"type": "string",
					"format": "date-time"
				},
				"assets": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["name", "size", "sha256"],
						"properties": {
							"name": {
								"type": "string",
								"pattern": "^(?:evidence-[a-z0-9][a-z0-9.-]{2,119}\\.(?:json|tar\\.gz)|release-evidence-fragment-[A-Za-z0-9.-]{1,100}\\.json)$"
							},
							"size": {
								"type": "integer",
								"minimum": 1
							},
							"sha256": {
								"$ref": "#/$defs/sha256"
							}
						}
					}
				}
			}
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"candidate": {
						"properties": {
							"commit": {
								"type": "null"
							}
						}
					}
				}
			},
			"then": {
				"properties": {
					"candidate": {
						"properties": {
							"tag": {
								"type": "null"
							}
						}
					},
					"packageVersion": {
						"type": "null"
					},
					"claimRegistrySha256": {
						"type": "null"
					},
					"promotion": {
						"type": "null"
					},
					"entries": {
						"maxItems": 0
					}
				}
			},
			"else": {
				"properties": {
					"candidate": {
						"properties": {
							"tag": {
								"type": "string"
							}
						}
					},
					"packageVersion": {
						"type": "string"
					},
					"claimRegistrySha256": {
						"type": "string"
					}
				}
			}
		}
	]
}
