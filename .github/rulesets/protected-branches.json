{
  "name": "Protected branches: no deletion, no force-push",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/development",
        "refs/heads/main",
        "refs/heads/canary",
        "refs/heads/nightly"
      ],
      "exclude": []
    }
  },
  "rules": [{ "type": "deletion" }, { "type": "non_fast_forward" }],
  "bypass_actors": []
}
