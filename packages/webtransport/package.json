{
	"name": "@webtransport-bun/webtransport",
	"version": "1.0.0-rc.1",
	"description": "Production-focused WebTransport for Bun, Node, and Deno with datagrams and streams via a Rust napi-rs addon",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vmeansdev/webtransport-bun.git"
	},
	"homepage": "https://github.com/vmeansdev/webtransport-bun#readme",
	"bugs": {
		"url": "https://github.com/vmeansdev/webtransport-bun/issues"
	},
	"keywords": [
		"bun",
		"node",
		"deno",
		"webtransport",
		"quic",
		"napi-rs",
		"realtime"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./wasm": {
			"import": "./dist/wasm.js",
			"types": "./dist/wasm.d.ts"
		}
	},
	"files": [
		"dist/**/*",
		"prebuilds/**/*",
		"wasm-dist/**/*",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"bun": ">=1.3.9",
		"node": ">=18"
	},
	"os": [
		"darwin",
		"linux",
		"win32"
	],
	"cpu": [
		"arm64",
		"x64"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"clean": "bun -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
		"build": "tsc -p tsconfig.build.json",
		"prebuild:native": "cd ../.. && bun scripts/copy-prebuilds.ts",
		"prebuild:build-and-copy": "cd ../.. && bun run build:native && bun scripts/copy-prebuilds.ts",
		"prebuild:checksums": "cd ../.. && bun scripts/write-sha256sums.ts packages/webtransport/prebuilds",
		"build:wasm-dist": "cd ../.. && crates/wasm/build-wasm.sh dist",
		"artifact:check": "bun ../../scripts/test-package-artifact.ts check",
		"artifact:build": "bun ../../scripts/test-package-artifact.ts build",
		"artifact:smoke": "bun ../../scripts/test-package-artifact.ts smoke",
		"pack:check": "npm run artifact:check",
		"prepublishOnly": "npm run artifact:build -- --verify-reproducible",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	}
}
