{
	"name": "@webtransport-bun/interop",
	"private": true,
	"type": "module",
	"scripts": {
		"test": "bun run test:once",
		"test:once": "WEBTRANSPORT_SUPPRESS_INSECURE_SKIP_VERIFY_WARN=1 bun run playwright test",
		"test:wasm-server": "bun run playwright test -c playwright.wasm.config.ts",
		"test:qpack": "WEBTRANSPORT_SUPPRESS_INSECURE_SKIP_VERIFY_WARN=1 bun run playwright test -c playwright.qpack.config.ts",
		"install:browsers": "playwright install chromium",
		"prepare:interop": "bun run prepare-certs.ts"
	},
	"devDependencies": {
		"@playwright/test": "1.58.2",
		"@types/bun": "1.3.9"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
